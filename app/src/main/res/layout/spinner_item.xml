<?xml version="1.0" encoding="utf-8"?>
<!--
    Closed state of the Gemini model spinner: up to 3 lines instead of one cut-off line. The end padding
    clears the arrow drawn by the spinner's background (bg_spinner).
-->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:ellipsize="end"
    android:gravity="center_vertical"
    android:layoutDirection="rtl"
    android:maxLines="3"
    android:minHeight="56dp"
    android:paddingStart="16dp"
    android:paddingTop="8dp"
    android:paddingEnd="48dp"
    android:paddingBottom="8dp"
    android:singleLine="false"
    android:textAlignment="viewStart"
    android:textAppearance="@style/TextAppearance.Clu.Body"
    android:textDirection="anyRtl" />
