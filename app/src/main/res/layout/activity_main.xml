<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Clu"
            android:textAlignment="viewStart"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="مفتاح Gemini API"
            android:textAlignment="viewStart" />

        <EditText
            android:id="@+id/apiKeyInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="الصق المفتاح هنا"
            android:importantForAutofill="no"
            android:inputType="textPassword"
            android:layoutDirection="ltr"
            android:textDirection="ltr"
            android:textAlignment="viewStart" />

        <TextView
            android:id="@+id/keyLink"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autoLink="web"
            android:text="احصل على مفتاح مجاني من: https://aistudio.google.com/apikey"
            android:textAlignment="viewStart"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="اسم النموذج"
            android:textAlignment="viewStart" />

        <EditText
            android:id="@+id/modelInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="gemini-3.5-flash"
            android:importantForAutofill="no"
            android:inputType="text"
            android:layoutDirection="ltr"
            android:textAlignment="viewStart" />

        <Button
            android:id="@+id/overlayButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="منح صلاحية الظهور فوق التطبيقات" />

        <Button
            android:id="@+id/startButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="تشغيل" />

        <Button
            android:id="@+id/stopButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="إيقاف" />
    </LinearLayout>
</ScrollView>
